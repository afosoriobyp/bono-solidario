# ─── Base de datos ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/bonos-solidarios

# ─── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_SECRET=cambia-este-secreto-en-produccion
NEXTAUTH_URL=http://localhost:3000

# ─── Correo (Nodemailer / SMTP) ────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tuemail@gmail.com
EMAIL_PASSWORD=tu-password-de-aplicacion
EMAIL_FROM=Bono Solidario <tuemail@gmail.com>

# ─── Brevo (envío de correos transaccionales y masivos) ────────
# Si BREVO_API_KEY está definido, se usa Brevo en lugar del SMTP de arriba.
BREVO_API_KEY=
BREVO_SENDER_NAME=Bono Solidario
BREVO_DAILY_LIMIT=300

# ─── Cron de correos (protege /api/cron/emails) ────────────────
CRON_SECRET=cambia-este-secreto-del-cron

# ─── Administrador ─────────────────────────────────────────────
ADMIN_EMAIL=admin@bonosolidario.com

# ─── Cloudflare R2 (storage de imágenes) ───────────────────────
# El bucket debe tener acceso público (r2.dev) para leer las URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ─── Datos bancarios para transferencias ──────────────────────
BANCO_NOMBRE=Banco Solidario
BANCO_CUENTA=0001-2345-6789
BANCO_TIPO_CUENTA=Cuenta Corriente
BANCO_TITULAR=Fundación Bono Solidario